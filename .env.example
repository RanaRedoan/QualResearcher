# ================================================================
#  Copy this file to ".env" and fill in GEMINI_API_KEY.
#  (start.bat does the copy for you the first time.)
#  Never share .env or upload it to GitHub — it holds your key.
# ================================================================

# ---- Required -------------------------------------------------
# Get it from https://aistudio.google.com → "Get API key"
GEMINI_API_KEY=

# ---- AI models (change only if you want to compare) ------------
GEMINI_TRANSCRIBE_MODEL=gemini-3.8-flash
GEMINI_TRANSLATE_MODEL=gemini-3.8-flash
# Used automatically if the main model is busy (503) for several minutes
GEMINI_FALLBACK_MODEL=gemini-3.6-flash

# Lower thinking = faster and fewer tokens (good for transcription). Leave empty for the model default.
GEMINI_THINKING_LEVEL=low
# How English words spoken inside Bangla are written: bangla (লোন) or latin (loan)
ENGLISH_WORDS_SCRIPT=bangla

# ---- Processing ------------------------------------------------
# If Google is busy, wait this many minutes and continue by itself (up to AUTO_RETRY_LIMIT times)
AUTO_RETRY_MINUTES=10
AUTO_RETRY_LIMIT=6
# Length of each audio piece sent to Gemini, in seconds (600 = 10 min)
CHUNK_SECONDS=1200
# How many recordings to process at the same time
LOCAL_WORKERS=1

# ---- App -------------------------------------------------------
APP_MODE=local
SITE_NAME=QualResearcher
DJANGO_SECRET_KEY=change-this-to-any-long-random-text


# ================================================================
#  ONLY for later, if you publish it as a website (APP_MODE=saas)
